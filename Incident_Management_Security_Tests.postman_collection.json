    {
      "name": "2. Tests de Sécurité Obligatoires (Section 25)",
      "item": [
        {
          "name": "Test 1: Accès sans JWT -> 401 Unauthorized",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Doit retourner 401', function () { pm.response.to.have.status(401); });"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/incidents/my", "host": ["{{baseUrl}}"], "path": ["api", "incidents", "my"] }
          }
        },
        {
          "name": "Test 2: Accès avec JWT invalide -> 401 Unauthorized",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Doit retourner 401', function () { pm.response.to.have.status(401); });"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer token.invalide.signature" }],
            "url": { "raw": "{{baseUrl}}/api/incidents/my", "host": ["{{baseUrl}}"], "path": ["api", "incidents", "my"] }
          }
        },
        {
          "name": "Test 3: Accès avec JWT expiré -> 401 Unauthorized",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Doit retourner 401', function () { pm.response.to.have.status(401); });"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJlbXBsb3llZTFAMS5jb20iLCJleHAiOjE2MDAwMDAwMDB9.invalidSig" }],
            "url": { "raw": "{{baseUrl}}/api/incidents/my", "host": ["{{baseUrl}}"], "path": ["api", "incidents", "my"] }
          }
        },
        {
          "name": "Test 4: EMPLOYEE tentant d'accéder à route ADMIN -> 403 Forbidden",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Doit retourner 403', function () { pm.response.to.have.status(403); });"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
